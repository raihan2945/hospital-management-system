# Local development values. Docker Compose reads .env automatically.
# SERVER_PORT is the host port; the application listens on 8080 in Docker.
SERVER_PORT=8080
# Hospital local date used by the dashboard (IANA timezone).
HOSPITAL_TIME_ZONE=Asia/Dhaka
# Set to true to add demo records to an empty database on startup.
DEMO_DATA=false
POSTGRES_PORT=5432
POSTGRES_DB=hospital_db
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
JPA_DDL_AUTO=update

# For running Java locally, export DATABASE_URL, DATABASE_USERNAME and
# DATABASE_PASSWORD in your shell instead; see README.md.
# Compose derives the JDBC settings from POSTGRES_* above.
